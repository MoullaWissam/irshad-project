# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ========== التبعيات ==========
/node_modules
/.pnp
.pnp.js
.pnp.cjs
.pnp.loader.mjs
yarn.lock
package-lock.json

# ========== الاختبار ==========
/coverage
*.log
*.tmp
*.temp

# ========== البناء والإنتاج ==========
/build
/dist
/.next
/out
.next/
out/

# ========== ملفات البيئة ==========
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.production
.env.staging

# ========== أنظمة التشغيل والIDE ==========
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
~$*
*.bak

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IDE - IntelliJ
.idea/
*.iml
*.ipr
*.iws

# ========== ملفات المشروع الكبيرة ==========

# نماذج 3D - تجاهل الملفات الأصلية فقط
/public/models/*.glb
!/public/models/*-compressed.glb  # استثناء الملفات المضغوطة
!/public/models/*-lowpoly.glb     # استثناء النماذج الخفيفة

# الصور - تجاهل الأصلية فقط
/public/media/*.png
/public/media/*.jpg
/public/media/*.jpeg
/public/media/*.gif
/public/media/*.bmp
!/public/media/*-optimized.webp   # استثناء الصور المحسنة
!/public/media/*-optimized.avif   # استثناء الصور المحسنة
!/public/media/*-optimized.jpg    # استثناء الصور المحسنة

# ملفات HDR الكبيرة
/public/*.hdr
/public/*.exr

# ========== Vite (للمستقبل) ==========
*.local
.cache/

# ========== Source maps ==========
*.map
*.map.js

# ========== أنظمة التحكم بالإصدار ==========
.git/
.svn/
.hg/

# ========== ملفات النظام المؤقتة ==========
tmp/
temp/
*.tmp
*.temp

# ========== ملفات npm/yarn ==========
npm-debug.log*
yarn-debug.log*
yarn-error.log*